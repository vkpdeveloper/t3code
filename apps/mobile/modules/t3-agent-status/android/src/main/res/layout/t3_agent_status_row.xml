<?xml version="1.0" encoding="utf-8"?>
<!--
  One agent. Also the collapsed view, where it shows the first agent plus a
  "+N" for the rest. No background, and notification text appearances so the
  colors follow the shade, not the app theme. The shade already draws the
  card, icon and app name, so the row only adds content.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/status_row_root"
  android:layout_width="match_parent"
  android:layout_height="40dp"
  android:gravity="center_vertical"
  android:orientation="horizontal">

  <TextView
    android:id="@+id/status_row_dot"
    android:layout_width="12dp"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:includeFontPadding="false"
    android:text="●"
    android:textSize="8sp" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/status_row_title"
      android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textSize="14sp" />

    <TextView
      android:id="@+id/status_row_metadata"
    android:textAppearance="@android:style/TextAppearance.Material.Notification"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textSize="12sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/status_row_more"
    android:textAppearance="@android:style/TextAppearance.Material.Notification"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:fontFamily="sans-serif-medium"
    android:includeFontPadding="false"
    android:textSize="12sp"
    android:visibility="gone" />

  <Chronometer
    android:id="@+id/status_row_chronometer"
    android:textAppearance="@android:style/TextAppearance.Material.Notification"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:includeFontPadding="false"
    android:textSize="12sp" />
</LinearLayout>
